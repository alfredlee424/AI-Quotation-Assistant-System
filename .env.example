# ============================================================
# AI 報價助理系統 - 環境變數設定範本
# 複製此檔案為 .env 並填入實際值
# ============================================================

# ----------------------------------------------------------
# LLM 設定（二擇一：標準 OpenAI 或 Azure OpenAI）
#
# 設定 OPENAI_API_KEY 後系統自動啟用 LLM Function Calling
# 未設定則使用規則式解析（rule-based）
# ----------------------------------------------------------
OPENAI_API_KEY=

# OpenAI 使用的模型（選填，預設 gpt-4o-mini）
# Azure OpenAI 模式：填入 Foundry 中實際建立的「部署名稱」（Deployment Name）
OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------------------
# Azure OpenAI（API Key 認證，適合一鍵啟動，無需 az login）
# 同時設定 OPENAI_API_KEY 與 AZURE_OPENAI_ENDPOINT 時自動使用 Azure OpenAI
#
# 取得方式：Azure Portal → Azure OpenAI 資源 → 金鑰和端點
# 端點格式：https://<resource-name>.openai.azure.com/
#          或 https://<resource-name>.services.ai.azure.com （AI Foundry 資源根端點）
# 注意：不要包含 /api/projects/... 尾段
# ----------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ----------------------------------------------------------
# 資料庫連線字串
# 一般 app.py 未設定時使用 SQLite；four_quote_acceptance.py --local-db 不會回退 SQLite
# --local-db 只讀本檔 DB_CONN_STR／WORKGROUP，不讀 LLM 設定，不自動建表
# ----------------------------------------------------------
# SQLite（預設，不需設定）
# DB_CONN_STR=

# MSSQL（切換至正式 ERP 資料庫時使用）
# DB_CONN_STR=mssql+pyodbc://使用者名稱:密碼@伺服器名稱/資料庫名稱?driver=ODBC+Driver+17+for+SQL+Server
# 本機 Windows MSSQL（示意值，需替換；不需 MySQL 伺服器）：
# DB_CONN_STR=mssql+pyodbc://quote_user:CHANGE_ME@localhost/QuoteDB?driver=ODBC+Driver+17+for+SQL+Server
# --local-db 允許 localhost、loopback、實際本機電腦名稱及本機具名 instance
# 僅 SQL Server 帳密驗證；需 SQL Server 2016+ 與已安裝 ODBC Driver 17／18
# 強制 Encrypt=yes，預設 TrustServerCertificate=no；確認為本機自簽憑證後才加 &TrustServerCertificate=yes
# 不接受遠端、DSN、odbc_connect 或帳密中的分號／大括號／控制字元；URL 保留字需百分比編碼
# 詳見 docs/Windows_MSSQL部署說明.md；缺表請交由 DBA 核對，不用一般 app.py 自動補表

# ----------------------------------------------------------
# 報價計算規則
# ----------------------------------------------------------
# 加成率（成本 × (1 + MARKUP_RATE) = 售價）
MARKUP_RATE=0.3

# 稅率
TAX_RATE=0.05

# 最大折扣上限（業務人員不得超過此值）
MAX_DISCOUNT_RATE=0.1

# ----------------------------------------------------------
# 事業別（workgroup）
# --local-db 必須 1～3 字元，與既有主檔一致；這不是產品類別代碼
# ----------------------------------------------------------
WORKGROUP=001

# ----------------------------------------------------------
# 稽核日誌
# ----------------------------------------------------------
# 日誌檔案路徑（預設 logs/ai_quote.log）
LOG_FILE=logs/ai_quote.log
